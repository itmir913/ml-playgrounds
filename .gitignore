# ── IDE ───────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# .claude/launch.json은 커밋한다 - .idea/runConfigurations와 같은 성격의
# 실행 구성이다 (CLAUDE.md §4). 개인 설정만 뺀다.
.claude/settings.local.json

# ── OS ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# 가상환경
.venv/
venv/
ENV/
env/
.python-version

# 테스트·린트 캐시
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# ── Node / 프런트엔드 ──────────────────────────────────
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.eslintcache
.vite/
frontend/dist/
frontend/dist-ssr/
# 백본 가중치는 빌드가 받는다 (frontend/scripts/fetch-backbone.mjs).
# 저장소에 12.4MB 바이너리를 넣지 않는다 - git 이력에 들어간 것은 다시 못 뺀다.
frontend/public/backbones/
*.local
.turbo/

# ── 환경 변수 / 비밀 ───────────────────────────────────
# SIGNING_SECRET 등이 절대 커밋되면 안 된다 (docs/mlpx-spec.md §7)
.env
.env.*
!.env.example

# ── 런타임 산출물 ──────────────────────────────────────
# 서버는 아무것도 영구 저장하지 않는다 (CLAUDE.md §1.1).
# 그럼에도 임시 작업 디렉터리가 저장소 안에 생기는 사고를 대비한다.
tmp/
*.log

# 학생 프로젝트 파일이 실수로 커밋되는 것을 막는다
*.mlpx
